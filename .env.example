# JWT signing (same as AUTH_SECRET on the Next.js FE if you verify tokens there)
AUTH_SECRET=dev-insecure-change-me

DATABASE_URL=sqlite:///./app.db

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000,https://ne.edutest.narxoz.kz

# First-run admin seed (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# **Required** for student sign-up: the API refuses registration until SMTP works and this URL is set
# (verification link: {PUBLIC_APP_BASE_URL}/ru/auth/verify-email?token=...). Use your deployed Next.js origin.
PUBLIC_APP_BASE_URL=https://ne.edutest.narxoz.kz

# --- Optional: notify staff when a new student registers ---
# Comma-separated inboxes that receive an HTML email when someone registers.
# Requires SMTP (below).
EMAIL_APPROVAL_NOTIFY_TO=you@example.com

# --- Outbound email (SMTP) ---
# **Required** for student sign-up (verification email). Also used for optional staff notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = STARTTLS after connect (typical with port 587). Set false if your relay does not support TLS.
SMTP_USE_TLS=true
# true = connect with implicit TLS (SMTP_SSL, typical with port 465). When true, SMTP_USE_TLS is ignored.
SMTP_USE_SSL=false
# From header (must be allowed by your provider)
SMTP_FROM=noreply@example.com

# --- PDF import (OpenAI) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o
# PDF_IMPORT_PAGE_DPI=200

# --- Sign in with Google (optional) ---
# OAuth 2.0 Web client ID (same as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend).
GOOGLE_OAUTH_CLIENT_ID=
